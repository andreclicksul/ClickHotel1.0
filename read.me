    restart: always
    environment:
      POSTGRES_USER: clickhotel
      POSTGRES_PASSWORD: jRQnOdqmKNhlrzoL
      POSTGRES_DB: clickhotel_api
      PGDATA: /var/lib/postgresql/data
    ports:
      - "15432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - networkClick

  pgadmin:
    container_name: pgadmin-clickhotel
    image: dpage/pgadmin4
    restart: always
    environment:
      PGADMIN_DEFAULT_EMAIL: "andre@clicksul.com.br"
      PGADMIN_DEFAULT_PASSWORD: "PgAdmin2023!"
    ports:
      - "16542:80"
    depends_on:
      - postgres
    volumes:
      - pgadmin_data:/var/lib/pgadmin      
    networks:
      - networkClick

  api:
    container_name: api-clickhotel
    depends_on:
      - postgres
    build:
      dockerfile: Dockerfile
      context: ./api
    restart: always
    env_file:
      - ./api/.env
    ports:
      - 6000:6000
    networks:
      - networkClick
 
  app:
    container_name: app-clickhotel
    build:
      dockerfile: Dockerfile
      context: ./app
    env_file:
