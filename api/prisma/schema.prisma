generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model tb_users {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user           String     @unique
  name           String
  email          String     @unique
  phone          String?
  password       String
  sunday         Boolean    @default(false)
  monday         Boolean    @default(false)
  tuesday        Boolean    @default(false)
  wednesday      Boolean    @default(false)
  thursday       Boolean    @default(false)
  friday         Boolean    @default(false)
  saturday       Boolean    @default(false)
  client         Int
  caduser        Int
  checklist      Int
  provider       Int
  audit          Int
  accountpay     Int
  accountreceive Int
  financial      Int
  product        Int
  occupationmap  Int
  cashflow       Int
  restaurant     Int
  uh             Int
  inactive       Boolean    @default(false)
  dtregister     DateTime   @default(dbgenerated("timezone('America/Sao_Paulo', now())"))
  lastchange     String
  color          String
  avatar         Int
  starthour      String
  startminute    String
  finishhour     String
  finishminute   String
  deleted        Boolean    @default(false)
  tb_audits      tb_audit[]
}

model tb_audit {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dtregister DateTime @default(dbgenerated("timezone('America/Sao_Paulo', now())"))
  typemodule String
  module     String
  beforeinf  String?
  currentinf String?
  ipaccess   String
  iduser     String   @db.Uuid
  user       tb_users @relation(fields: [iduser], references: [id])
}

model tb_client {
  idclient         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dtregister       DateTime @default(dbgenerated("timezone('America/Sao_Paulo', now())"))
  desname          String
  dtnasc           DateTime @db.Date
  descel           String?
  descep           String?
  desstreet        String?
  desnumber        String?
  descomplement    String?
  desdistrict      String?
  descity          String?
  desuf            String?
  descpf           String?
  desemail         String?
  desrestalimentar String?
  desveiculo       String?
  desobs           String?  @db.Text
  lastchange       String?
}

model tb_provider {
  idprovider    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dtregister    DateTime @default(dbgenerated("timezone('America/Sao_Paulo', now())"))
  desname       String
  descorporate  String?
  desphone      String?
  descel        String?
  descep        String?
  desstreet     String?
  desnumber     String?
  descomplement String?
  desdistrict   String?
  descity       String?
  desuf         String?
  descnpj       String?
  desie         String?
  desobs        String?  @db.Text
  desemail      String?
  lastchange    String?
  inactive      Boolean  @default(false)
}
